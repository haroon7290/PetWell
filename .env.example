# --- Required ---
# Postgres connection string. On Vercel, adding a Neon database from the Marketplace sets this for you.
DATABASE_URL=postgres://user:password@host:5432/petwell
# Any long random string (keep it secret). Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Your site's public address, without a trailing slash
NEXT_PUBLIC_SERVER_URL=https://your-site.vercel.app

# --- Images ---
# Vercel → Storage → Create Blob store → connect to this project (sets this automatically)
BLOB_READ_WRITE_TOKEN=

# --- Payments (Stripe) ---
# Stripe Dashboard → Developers → API keys → Secret key (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
